# =================================
# CONFIGURACIÓN DE SINGULAR.LIVE
# =================================
# Obtén estas credenciales desde el dashboard de Singular.live
# Ver docs/INSTALLATION.md para instrucciones detalladas

SINGULAR_APP_INSTANCE_ID=app-123e4567-e89b-12d3-a456-426614174000
SINGULAR_SHARED_TOKEN=singular_live_token_xxxxxxxxxxxxxxxxxx
SINGULAR_API_KEY=your_singular_api_key_here

# =================================
# BASE DE DATOS (SQLite para deployment local)
# =================================
# SQLite database file (se crea automáticamente)
DATABASE_URL=sqlite+aiosqlite:///./news_scraper.db

# =================================
# REDIS (Opcional - deshabilitado por defecto)
# =================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Si tienes Redis disponible, cambia a true:
# REDIS_ENABLED=true

# =================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =================================
# Clave secreta para JWT y sesiones (generar con: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Entorno: development, production, testing
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Host y puerto del backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Host y puerto del frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# URL del backend (para llamadas desde el frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =================================
# CONFIGURACIÓN DE SCRAPING
# =================================
# Intervalo de scraping en minutos
SCRAPING_INTERVAL=5

# Timeout para requests HTTP en segundos
REQUEST_TIMEOUT=30

# Número máximo de reintentos
MAX_RETRIES=3

# User Agent para requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Rate limiting: requests por minuto
RATE_LIMIT_PER_MINUTE=60

# =================================
# LOGGING
# =================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Formato de log: json, text
LOG_FORMAT=text

# =================================
# CORS
# =================================
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://news-scraper.vercel.app

# =================================
# CACHÉ
# =================================
# Tiempo de expiración del caché en segundos
CACHE_TTL=300

# Habilitar/deshabilitar caché
CACHE_ENABLED=true
